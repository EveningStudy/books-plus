{
  "name": "icloud-books-reader",
  "version": "0.5.0",
  "private": true,
  "description": "Books+ desktop reader with cloud libraries, offline neural narration and desktop subtitles",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "node scripts/build-mac-helper.mjs && node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "package:win": "npm run build && electron-builder --win nsis portable --x64 --publish never",
    "package:mac": "npm run build:mac-helper && npm run build && electron-builder --mac dir --publish never",
    "build:mac-helper": "node scripts/build-mac-helper.mjs",
    "package:mac:dmg": "npm run build:mac-helper && npm run build && electron-builder --mac dmg zip --publish never",
    "postinstall": "node node_modules/electron/install.js",
    "test:mac": "node scripts/test-mac.cjs",
    "prestart": "node scripts/build-mac-helper.mjs",
    "test:desktop": "node scripts/test-handoff.cjs",
    "test:i18n": "node scripts/test-i18n.cjs",
    "test:providers": "npm run build:mac-helper && node scripts/test-providers.cjs"
  },
  "build": {
    "appId": "study.evening.reader",
    "productName": "Books+",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "BooksPlus-${version}-${arch}.${ext}",
      "icon": "desktop/icon.png",
      "signExecutable": "false"
    },
    "mac": {
      "artifactName": "BooksPlus-${version}-${arch}.${ext}",
      "category": "public.app-category.books",
      "target": "dir",
      "minimumSystemVersion": "13.0",
      "icon": "desktop/icon.png",
      "hardenedRuntime": true,
      "extendInfo": {
        "NSHumanReadableCopyright": "Copyright © EveningStudy",
        "NSDocumentsFolderUsageDescription": "Books+ accesses the cloud library folder you select.",
        "NSDownloadsFolderUsageDescription": "Books+ imports books you select."
      },
      "extraResources": [
        {
          "from": "build/native/booksplus-bridge",
          "to": "booksplus-bridge"
        }
      ],
      "identity": "-",
      "entitlements": "desktop/macos/entitlements.plist",
      "entitlementsInherit": "desktop/macos/entitlements.plist"
    },
    "electronDist": "node_modules/electron/dist",
    "asarUnpack": [
      "node_modules/sherpa-onnx*/**/*"
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "BooksPlus-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "BooksPlus-${version}-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "EveningStudy",
        "repo": "books-plus"
      }
    ]
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "electron-updater": "^6.8.11",
    "epubjs": "^0.3.93",
    "fast-xml-parser": "^5.11.2",
    "jszip": "^3.10.2",
    "lucide-react": "^1.61.0",
    "marked": "^18.1.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanitize-html": "^2.18.1",
    "semver": "^7.8.5",
    "sherpa-onnx-node": "1.13.8",
    "tar": "^7.5.22",
    "unbzip2-stream": "^1.4.3",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.9.12",
    "plist": "4.0.0"
  },
  "type": "module",
  "author": "EveningStudy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/EveningStudy/books-plus.git"
  },
  "homepage": "https://github.com/EveningStudy/books-plus",
  "engines": {
    "node": ">=24.0.0"
  }
}
